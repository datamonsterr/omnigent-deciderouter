# --- OpenRouter -------------------------------------------------------------
# Optional. Without a key the server still runs and answers via its local
# heuristic fallback (source: "heuristic").
OPENROUTER_API_KEY=

# Decision-model chain, tried in order: free first, then cheap.
# Any of these can be overridden per-request via
# route_selector.config.decider_models in the Omnigent request.
DECIDER_MODELS=inception/mercury-decide:free,google/gemini-2.5-flash-lite

# Model ids (exact, comma-separated) that must use the OpenRouter Decisions
# API although their name is not recognized (e.g. liquid/d1). TypeSafe Jev ids
# (~typesafe/jev-latest, typesafe/jev-1.14) and ids with a decide / decider /
# decision(s) name segment are recognized automatically. Check with
# `bun run check:models`.
DECISIONS_MODELS=

# Base URL used to build both OpenRouter endpoints (mainly for tests).
OPENROUTER_BASE_URL=https://openrouter.ai
# Full override for the Decisions API endpoint (optional).
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# --- Server -------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# If set, POST /routes:select requires `Authorization: Bearer <this value>`.
# Configure the same value as routing.api_key in Omnigent.
ROUTER_API_KEY=

# Overall decision budget in milliseconds (default 8000). If every decider
# model fails or the budget runs out, the local heuristic answers instead.
ROUTER_TIMEOUT_MS=8000
